{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "sadhna-bhakt.vercel.app" }],
      "destination": "https://www.kanishthbhakta.in/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|privacy\\.html|terms\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
